<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="megventure_faq" resource="default" engine="innodb" comment="FAQ entries">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entry ID"/>
        <!--
            0 means the entry is shared: it shows on every product page. Any
            other value attaches it to that one product. This mirrors how a
            merchant actually writes FAQs - most answers are about the shop,
            not about one item.
        -->
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" default="0"
                comment="Product ID, 0 for a shared entry"/>
        <column xsi:type="int" name="position" unsigned="true" nullable="false" default="0"
                comment="Sort order"/>
        <column xsi:type="boolean" name="is_active" nullable="false" default="true"
                comment="Published"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Updated"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="MEGVENTURE_FAQ_PRODUCT_ID_IS_ACTIVE_POSITION" indexType="btree">
            <column name="product_id"/>
            <column name="is_active"/>
            <column name="position"/>
        </index>
    </table>

    <table name="megventure_faq_value" resource="default" engine="innodb"
           comment="FAQ question and answer per store view">
        <column xsi:type="int" name="value_id" unsigned="true" nullable="false" identity="true"
                comment="Value ID"/>
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" comment="Entry ID"/>
        <!--
            Store 0 is the default text. A store view with no row of its own
            falls back to it, which is how the rest of Magento behaves and
            removes the "translated in some languages only" hole.
        -->
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0"
                comment="Store view ID, 0 for the default text"/>
        <column xsi:type="varchar" name="question" nullable="false" length="500" comment="Question"/>
        <column xsi:type="text" name="answer" nullable="true" comment="Answer"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="value_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MEGVENTURE_FAQ_VALUE_ENTITY_ID_STORE_ID">
            <column name="entity_id"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MEGVENTURE_FAQ_VALUE_ENTITY_ID_MEGVENTURE_FAQ_ENTITY_ID"
                    table="megventure_faq_value" column="entity_id"
                    referenceTable="megventure_faq" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="MEGVENTURE_FAQ_VALUE_STORE_ID" indexType="btree">
            <column name="store_id"/>
        </index>
    </table>

</schema>
