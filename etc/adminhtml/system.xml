<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="megventure_faq" translate="label" type="text" sortOrder="20"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Product FAQ</label>
            <tab>megventure</tab>
            <resource>Megventure_Faq::config</resource>

            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable module</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Turns off the product block and the FAQ page at once. Entries are kept.</comment>
                </field>
            </group>

            <group id="display" translate="label comment" type="text" sortOrder="20"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Where it shows</label>
                <comment><![CDATA[Everything this module renders is in the server response, so a crawler that does not
                    run scripts still reads the answers &mdash; and so does an assistant quoting the page.]]></comment>
                <field id="on_product" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Show on product pages</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="shared_on_product" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Include shared entries on product pages</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>A shared entry is one with product ID 0. Turn this off to show only entries written for the product itself.</comment>
                    <depends><field id="on_product">1</field></depends>
                </field>
                <field id="faq_page" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Publish the FAQ page</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Every published entry on one page at /faq.</comment>
                </field>
                <field id="open_first" translate="label comment" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Open the first entry</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>The rest start collapsed. All of them are in the HTML either way.</comment>
                </field>
                <field id="fallback_to_default" translate="label comment" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Fall back to the default text</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When a store view has no text of its own, show the default store's text rather than nothing.</comment>
                </field>
                <field id="heading" translate="label comment" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Heading</label>
                    <comment>Shown above the entries on both the product page and the FAQ page.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
